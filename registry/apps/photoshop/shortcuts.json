      }
    },
    {
      "id": "undo",
      "intent": "Undo the most recent edit on the active document",
      "parameters": [],
      "platforms": ["macos"],
      "app_versions": ["25+"],
      "method": "shortcut",
      "actions": [
        { "type": "key_combo", "keys": { "macos": "cmd+z" } }
      ],
      "verification": {
        "type": "interpret_check",
        "question": "Looking at the screen, has the most recent edit on the active document been undone? The canvas should now reflect the state from before the previous action.",
        "expected": "yes"
      },
      "metadata": {
        "contributor_id": "seed",
        "payment_destination": null,
        "token_cost_estimate": 5,
        "speed_estimate_ms": 100,
        "submitted_at": "2026-05-03"
      }
    },
    {
      "id": "adjust-brightness",
      "intent": "Apply a brightness shift to the active layer (positive brightens, negative darkens)",
      "parameters": [
        {
          "name": "delta",
          "type": "number",
          "required": true
        }
      ],
      "platforms": ["macos"],
      "app_versions": ["25+"],
      "method": "menu",
      "actions": [
        { "type": "menu", "path": ["Image", "Adjustments", "Brightness/Contrast..."] },
        { "type": "key_combo", "keys": { "macos": "cmd+a" } },
        { "type": "type_text", "text": "{delta}" },
        { "type": "key", "key": "enter" }
      ],
      "verification": {
        "type": "interpret_check",
        "question": "Has the active document become noticeably brighter (if delta > 0) or darker (if delta < 0) by approximately {delta} brightness units compared to its previous state?",
        "expected": "yes"
      },
      "metadata": {
        "contributor_id": "seed",
        "payment_destination": null,
        "token_cost_estimate": 50,
        "speed_estimate_ms": 1500,
        "submitted_at": "2026-05-03"
      }
    },
    {
      "id": "crop-to-size",
      "intent": "Crop the canvas to {width}×{height}, centered on the current canvas. Positioning (x, y) and rotation are not supported in this shortcut — use the explorer skill to discover precise crop primitives if needed.",
      "parameters": [
        { "name": "width", "type": "number", "required": true },
        { "name": "height", "type": "number", "required": true }
      ],
      "platforms": ["macos"],
      "app_versions": ["25+"],
      "method": "menu",
      "actions": [
        { "type": "menu", "path": ["Image", "Canvas Size..."] },
        { "type": "key_combo", "keys": { "macos": "cmd+a" } },
        { "type": "type_text", "text": "{width}" },
        { "type": "key", "key": "tab" },
        { "type": "key_combo", "keys": { "macos": "cmd+a" } },
        { "type": "type_text", "text": "{height}" },
        { "type": "key", "key": "enter" }
      ],
      "verification": {
        "type": "interpret_check",
        "question": "Has the canvas been cropped to approximately {width}×{height}, centered on the original?",
        "expected": "yes"
      },
      "metadata": {
        "contributor_id": "seed",
        "payment_destination": null,
        "token_cost_estimate": 40,
        "speed_estimate_ms": 1500,
        "submitted_at": "2026-05-03"
      }
    },
    {
      "id": "convert-to-grayscale",
      "intent": "Convert the active document's color mode to Grayscale, discarding color information",
      "parameters": [],
      "platforms": ["macos"],
      "app_versions": ["25+"],
      "method": "menu",
      "actions": [
        { "type": "menu", "path": ["Image", "Mode", "Grayscale"] },
        { "type": "key", "key": "enter" }
      ],
      "verification": {
        "type": "interpret_check",
        "question": "Does the active document now appear in grayscale (no color visible in the canvas, and the document title or layers panel reflecting the Gray color mode)?",
        "expected": "yes"
      },
      "metadata": {
        "contributor_id": "seed",
        "payment_destination": null,
        "token_cost_estimate": 30,
        "speed_estimate_ms": 800,
        "submitted_at": "2026-05-03"
      }
    }
  ]
}
