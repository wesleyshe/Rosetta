{
  "schema_version": 1,
  "app_id": "photoshop",
  "shortcuts": [
    {
      "id": "open-file",
      "intent": "Open an image file by absolute path as a new active document in Photoshop",
      "parameters": [
        { "name": "path", "type": "string", "required": true }
      ],
      "platforms": ["macos"],
      "app_versions": ["25+"],
      "method": "shortcut",
      "actions": [
        { "type": "key_combo", "keys": { "macos": "cmd+o" } },
        { "type": "key_combo", "keys": { "macos": "cmd+shift+g" } },
        { "type": "type_text", "text": "{path}" },
        { "type": "key", "key": "enter" },
        { "type": "key", "key": "enter" }
      ],
      "verification": {
        "type": "interpret_check",
        "question": "Looking at the screen, is the image file at {path} now open as the active document in Photoshop (visible in the canvas with its filename in the active document tab)?",
        "expected": "yes"
      },
      "metadata": {
        "contributor_id": "seed",
        "payment_destination": null,
        "token_cost_estimate": 50,
        "speed_estimate_ms": 1200,
        "submitted_at": "2026-05-03"
      }
    },
    {
      "id": "save-as-jpg",
      "intent": "Save a copy of the active document as a JPG file at the given absolute path",
      "parameters": [
        { "name": "path", "type": "string", "required": true },
        {
          "name": "quality",
          "type": "number",
          "required": false,
          "minimum": 0,
          "maximum": 12,
          "description": "JPG quality, Photoshop's native 0-12 scale (the 'Save a Copy' → JPG Options dialog scale, NOT the 0-100 scale used by Save for Web / Export As). 12 = highest quality, 0 = highest compression. Defaults to Photoshop's last-used value if omitted."
        }
      ],
      "platforms": ["macos"],
      "app_versions": ["25+"],
      "method": "menu",
      "actions": [
        { "type": "menu", "path": ["File", "Save a Copy..."] },
        { "type": "key_combo", "keys": { "macos": "cmd+shift+g" } },
        { "type": "type_text", "text": "{path}" },
        { "type": "key", "key": "enter" },
        { "type": "key", "key": "enter" },
        { "type": "key_combo", "keys": { "macos": "cmd+a" } },
        { "type": "type_text", "text": "{quality}" },
        { "type": "key", "key": "enter" }
      ],
      "verification": {
        "type": "file_check",
        "path": "{path}",
        "exists": true
      },
      "metadata": {
        "contributor_id": "seed",
        "payment_destination": null,
        "token_cost_estimate": 80,
        "speed_estimate_ms": 3000,
        "submitted_at": "2026-05-03"
      }
    },
    {
      "id": "save-as-png",
