      "verification": {
        "type": "interpret_check",
        "question": "Looking at the active editor before and after this action, has the code been reformatted (consistent indentation applied, trailing whitespace removed, brace placement normalized, or similar formatter changes)?",
        "expected": "yes"
      },
      "metadata": {
        "contributor_id": "seed",
        "payment_destination": null,
        "token_cost_estimate": 60,
        "speed_estimate_ms": 700,
        "submitted_at": "2026-05-03"
      }
    },
