    {
      "id": "toggle-zen-mode",
      "intent": "Toggle zen mode (full-screen distraction-free editing) on or off",
      "parameters": [],
      "platforms": [
        "macos",
        "windows",
        "linux"
      ],
      "app_versions": [
        "1.85+"
      ],
      "method": "search",
      "actions": [
        {
          "type": "key_combo",
          "keys": {
            "macos": "cmd+shift+p",
            "windows": "ctrl+shift+p",
            "linux": "ctrl+shift+p"
          }
        },
