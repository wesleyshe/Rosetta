    {
      "id": "format-current-file",
      "intent": "Apply the configured formatter to the active file",
      "parameters": [],
      "platforms": [
        "macos",
        "windows",
        "linux"
      ],
      "app_versions": [
        "1.85+"
      ],
      "method": "search",
      "actions": [
        {
          "type": "key_combo",
          "keys": {
            "macos": "cmd+shift+p",
            "windows": "ctrl+shift+p",
            "linux": "ctrl+shift+p"
          }
        },
        {
          "type": "type_text",
          "text": "Format Document"
        },
        {
          "type": "key",
          "key": "enter"
        }
