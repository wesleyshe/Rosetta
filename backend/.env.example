# Copy to backend/.env (gitignored) for local dev. In Railway, set these as
# project env vars; Railway injects them into the deployed service.

# Postgres connection string. Railway provides this when you add the Postgres
# add-on (decision D: use the Railway connection string in dev too, single
# source of truth).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# GitHub OAuth App credentials (decision E: classic OAuth App, not GitHub App).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Repo coordinates the backend writes submitted shortcuts to. Should be the
# same repo this backend is deployed from in v0.
GITHUB_REPO_OWNER=wesleyshe
GITHUB_REPO_NAME=Rosetta

# Anthropic API key for the reviewer LLM (decision G: claude-sonnet-4-6).
ANTHROPIC_API_KEY=
ROSETTA_REVIEWER_MODEL=claude-sonnet-4-6

# Where Fastify listens. Railway sets PORT automatically; for local dev,
# default to 3000 to match scripts/dev-server.mjs.
PORT=3000
